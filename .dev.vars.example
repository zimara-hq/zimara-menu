# Copy to .dev.vars for `npm run dev`. Never commit real values.
AUTH_SECRET=change-me-to-48-random-bytes
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Subscription payments (Moyasar). Leave empty to keep checkout disabled.
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8787
# Only after ZIMARA is VAT-registered: 1500 = 15%
VAT_RATE_BPS=0
# Simple Fatoora (subscription e-invoices). Use a sandbox key for review; never commit a key.
SIMPLE_FATOORA_API_KEY=
SIMPLE_FATOORA_ENABLED=false
SIMPLE_FATOORA_SELLER_PROFILE_APPROVED=false
SIMPLE_FATOORA_ENV=sandbox
SIMPLE_FATOORA_LIVE_ISSUING_ENABLED=false

# Transactional email (Resend). Leave empty to keep email disabled.
RESEND_API_KEY=
MAIL_FROM=ZIMARA <no-reply@zimara.co>

# Direct Rewaa link (polling). Needs POS_ENCRYPTION_KEY too. REWAA_SALES_PATH only if Rewaa support gives a different sale-invoice list path.
REWAA_ENABLED=false
# REWAA_SALES_PATH=/pos/invoices
