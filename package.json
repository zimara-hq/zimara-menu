{
  "name": "zimara-menu",
  "version": "1.0.0",
  "description": "ZIMARA Menu: e-menu, smart pager and loyalty cards",
  "scripts": {
    "test": "node --test --no-warnings test/*.test.js",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply zimara-menu-db --local",
    "admin:create": "node scripts/admin-create.mjs",
    "deploy": "wrangler deploy",
    "test:e2e": "node test/e2e/connected.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "test:onboarding": "node test/e2e/onboarding.mjs",
    "test:workspace": "node test/e2e/workspace.mjs",
    "test:resilience": "node test/e2e/resilience.mjs",
    "test:design": "node test/e2e/design.mjs",
    "test:magic": "node test/e2e/magic.mjs",
    "test:ordering": "node test/e2e/ordering.mjs",
    "test:waitlist": "node test/e2e/waitlist.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zimara-hq/zimara-menu.git"
  },
  "bugs": {
    "url": "https://github.com/zimara-hq/zimara-menu/issues"
  },
  "homepage": "https://github.com/zimara-hq/zimara-menu#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "qrcode-generator": "^1.4.4",
    "wrangler": "^4.156.0"
  },
  "type": "module",
  "private": true
}
